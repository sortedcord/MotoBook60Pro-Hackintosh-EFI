+
+// <local> report 4 = 2 length bytes, ID, 5 finger slots, scan time u16, contact count, button. A slot is 7 bytes with
+// pressure (ThinkBook 14+ GXTP5100, 42-byte frame) or 5 without (moto book 60 pro GXTP5100, 32-byte frame): the slot size
+// follows from the frame length, and the scan time sits right after the five slots.
+bool VoodooI2CHIDDevice::glitchLayout(UInt32 size) {
+    if (size < 32 || (size - 7) % 5) return false;
+    UInt32 stride = (size - 7) / 5;
+    if (stride < 5 || stride > 9) return false;
+    gl_stride = stride; gl_scan = 3 + 5 * stride;
+    return true;
+}
