+// Report individual stalls after dispatch. This reads the existing timestamp
+// calibration and leaves the fence, marking, and publication order unchanged.
+static void nvmtl_ws_part_diagnostics(const nvk_cmdbuf *commands, uint64_t workerStart,
+                                     uint64_t submitDone, uint64_t marksDone, uint64_t publishDone) {
+    const uint64_t fenceDone = commands->timing.host_after_ns;
+    double gpuStart, gpuEnd;
+    if (fenceDone < workerStart || fenceDone > submitDone ||
+        nvmtl_vk_interval_seconds(&commands->timing, &gpuStart, &gpuEnd)) return;
+    const double gpuEndNs = gpuEnd * 1e9;
+    if (gpuEndNs <= 0 || gpuEndNs > (double)publishDone ||
+        (double)publishDone - gpuEndNs < 20000000.0) return;
+    static _Atomic unsigned reported;
+    if (atomic_fetch_add(&reported, 1) >= 24) return;
+    const double readyForWorker = (double)workerStart - gpuEndNs;
+    nvlog("WindowServer completion: GPU end to worker %.1f ms (negative means the worker was already waiting), "
+          "worker to fence/witness %.1f ms, query/retire %.1f ms, ready marks %.1f ms, publication %.1f ms",
+          readyForWorker / 1e6, (fenceDone - workerStart) / 1e6, (submitDone - fenceDone) / 1e6,
+          (marksDone - submitDone) / 1e6, (publishDone - marksDone) / 1e6);
+}
